# Copy this file to .env.local and fill in the values from your Supabase
# project's dashboard: Project Settings → API.
#
# Both are safe to expose in the browser (NEXT_PUBLIC_*) — Supabase's Row
# Level Security policies (see supabase/schema.sql) are what actually keep
# data safe, not secrecy of these values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical site origin — used for Open Graph image URLs and share links.
# Must be the real https:// domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ — this key bypasses Row Level
# Security and must never reach the browser. Only needed to run one-off admin
# scripts such as scripts/migrate-images-to-storage.mjs.
# Supabase dashboard -> Settings -> API -> Secret keys
SUPABASE_SECRET_KEY=sb_secret_your_key_here
